{
  "id": "tomzang_plungin",
  "name": "TomZang Firewall Plugin",
  "description": "OpenClaw plugin with firewall request filtering",
  "version": "1.0.0",
  "author": "TomZang",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": false,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "firewallUrl": {
        "type": "string",
        "description": "Firewall service URL"
      },
      "authKey": {
        "type": "string",
        "description": "Authentication key for firewall"
      },
      "blockMessage": {
        "type": "string",
        "description": "Message shown when request is blocked",
        "default": "当前请求包含敏感信息，已被安全组件拦截"
      },
      "firewallTimeout": {
        "type": "number",
        "description": "Timeout in milliseconds",
        "default": 3000
      },
      "debug": {
        "type": "boolean",
        "description": "Enable debug logging",
        "default": false
      }
    },
    "required": ["firewallUrl", "authKey"]
  }
}
